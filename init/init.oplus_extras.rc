on boot
    # Adrenoboost
    chown system system /sys/class/kgsl/kgsl-3d0/devfreq/adrenoboost
    chmod 0666 /sys/class/kgsl/kgsl-3d0/devfreq/adrenoboost

    # Anti-Flicker
    chown system system /sys/kernel/oplus_display/dimlayer_bl_en
    chmod 0666 /sys/kernel/oplus_display/dimlayer_bl_en

    # Force Fast Charge
    chown system system /sys/kernel/fast_charge/force_fast_charge
    chmod 0666 /sys/kernel/fast_charge/force_fast_charge

    # HBM
    chown system system /sys/kernel/oplus_display/hbm
    chmod 0666 /sys/kernel/oplus_display/hbm

    # Vibration Intensity
    chown system system /sys/devices/platform/soc/a8c000.i2c/i2c-6/6-005a/leds/vibrator/level
    chmod 0666 /sys/devices/platform/soc/a8c000.i2c/i2c-6/6-005a/leds/vibrator/level
