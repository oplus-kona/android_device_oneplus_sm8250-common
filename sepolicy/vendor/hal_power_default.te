# Allow hal_power_default to set scheduling attributes and uclamp for ADPF
allow hal_power_default self:capability sys_nice;
allow hal_power_default appdomain:process { getsched setsched };
# getsched is needed to read the target policy before writing uclamp: the
# kernel rejects a zero priority on an RT thread, and set_uclamp() has to
# know which priority the thread requires.
allow hal_power_default surfaceflinger:process { getsched setsched };
allow hal_power_default hal_graphics_composer_default:process { getsched setsched };
allow hal_power_default system_server:process { getsched setsched };

# Applying a task profile to an app thread, SetAttribute resolves the target
# cgroup by reading /proc/<tid>/cgroup (cgroup_map.cpp GetTaskGroup), which
# lives under the app's own /proc directory. Without this every
# SCHED_QOS_*/ADPF_* profile fails with "Failed to read /proc/<tid>/cgroup:
# Permission denied" before it reaches the cgroup file. Same shape as the
# grant performanced has for the same reason, and limited to appdir and the
# one file so the HAL still cannot enumerate app proc entries.
allow hal_power_default appdomain:dir search;
allow hal_power_default appdomain:{ file lnk_file } r_file_perms;
