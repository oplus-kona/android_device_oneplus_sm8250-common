# Allow hal_power_default to set scheduling attributes and uclamp for ADPF
allow hal_power_default self:capability sys_nice;
allow hal_power_default appdomain:process { getsched setsched };
# getsched is needed to read the target policy before writing uclamp: the
# kernel rejects a zero priority on an RT thread, and set_uclamp() has to
# know which priority the thread requires.
allow hal_power_default surfaceflinger:process { getsched setsched };
allow hal_power_default hal_graphics_composer_default:process { getsched setsched };
allow hal_power_default system_server:process { getsched setsched };
